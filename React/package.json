{
  "name": "journey-to-the-west-memory-palace",
  "version": "1.0.0",
  "description": "西遊記記憶宮殿 - A bilingual memory palace app for learning Chinese characters using Journey to the West imagery and Matteo Ricci's mnemonic techniques",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint src/",
    "python-server": "cd python && python memory_palace.py"
  },
  "keywords": [
    "chinese",
    "language-learning",
    "memory-palace",
    "mnemonic",
    "journey-to-the-west",
    "西遊記",
    "matteo-ricci",
    "giordano-bruno",
    "arcgis",
    "storymaps",
    "react-native",
    "expo"
  ],
  "author": "Memory Palace Development Team",
  "license": "MIT",
  "dependencies": {
    "expo": "~49.0.0",
    "expo-av": "~13.4.1",
    "expo-status-bar": "~1.6.0",
    "react": "18.2.0",
    "react-native": "0.72.6",
    "react-native-maps": "1.7.1",
    "react-native-reanimated": "~3.3.0",
    "react-native-gesture-handler": "~2.12.0",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/stack": "^6.3.17",
    "@reduxjs/toolkit": "^1.9.5",
    "react-redux": "^8.1.2",
    "@react-native-async-storage/async-storage": "1.18.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.14",
    "eslint": "^8.45.0",
    "jest": "^29.6.1",
    "typescript": "^5.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/journey-to-the-west-memory-palace.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "expo": {
    "name": "西遊記記憶宮殿",
    "slug": "journey-to-the-west-memory-palace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1C1C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.memorypalace.journeytothewest"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C1C1C"
      },
      "package": "com.memorypalace.journeytothewest"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
